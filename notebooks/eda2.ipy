import pandas as pd

# Load dataset
df = pd.read_csv("data/processed/cleaned_cosmetics_dataset.csv")

# Check rows and columns
print("Dataset Shape:", df.shape)

# Column names
print("\nColumn Names:")
print(df.columns.tolist())

# First 5 rows
print("\nFirst 5 Rows:")
print(df.head())

# Data types
print("\nData Types:")
print(df.dtypes)


# Step 2: Missing Values & Duplicate Values

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:")
print(df.duplicated().sum())

# Step 3: Numerical & Categorical Columns

# Numerical columns
numerical_columns = df.select_dtypes(
    include="number"
).columns.tolist()

print("\nNumerical Columns:")
print(numerical_columns)

# Categorical columns
categorical_columns = df.select_dtypes(
    include="object"
).columns.tolist()

print("\nCategorical Columns:")
print(categorical_columns)


# Step 4: Descriptive Statistics

print("\nDescriptive Statistics:")
print(df.describe())

print("\nImportant Columns Statistics:")

print(df[[
    "tenure",
    "total",
    "income",
    "quantity"
]].describe())

# Step 5: Purchased Column Analysis

print("\nPurchase Counts:")
print(df["purchased"].value_counts())

print("\nPurchase Percentages:")
print(df["purchased"].value_counts(normalize=True) * 100)



import matplotlib.pyplot as plt

# Graph 1: Purchase distribution
purchase_counts = df["purchased"].value_counts().sort_index()

# Calculate percentages
purchase_percentages = (
    purchase_counts / purchase_counts.sum()
) * 100

plt.figure(figsize=(6, 4))

bars = plt.bar(
    ["Not Purchased", "Purchased"],
    purchase_counts.values
)

plt.title("Purchase Distribution")
plt.xlabel("Purchase Status")
plt.ylabel("Number of Customers")

# Add count and percentage labels
for bar, count, percentage in zip(
    bars,
    purchase_counts.values,
    purchase_percentages.values
):
    plt.text(
        bar.get_x() + bar.get_width() / 2,
        bar.get_height() + 100,
        f"{count} ({percentage:.1f}%)",
        ha="center",
        fontsize=10
    )

plt.tight_layout()
plt.show()


# Graph 2: Gender Distribution

import matplotlib.pyplot as plt

# Count gender categories
gender_counts = df["sex"].value_counts()

print("\nGender Distribution:")
print(gender_counts)

# Create bar chart
plt.figure(figsize=(6, 4))

bars = plt.bar(
    gender_counts.index,
    gender_counts.values
)

plt.title("Gender Distribution")
plt.xlabel("Gender")
plt.ylabel("Number of Customers")

# Add count labels
for bar, count in zip(bars, gender_counts.values):
    plt.text(
        bar.get_x() + bar.get_width() / 2,
        bar.get_height() + 50,
        str(count),
        ha="center",
        fontsize=10
    )

plt.tight_layout()
plt.show()


# Graph 3: Age Group Distribution

import matplotlib.pyplot as plt

# Count age groups
age_counts = df["age_group"].value_counts()

print("\nAge Group Distribution:")
print(age_counts)

# Calculate percentages
age_percentages = (
    age_counts / age_counts.sum()
) * 100

# Create bar chart
