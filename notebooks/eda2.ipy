# Step 6: Status Distribution

status_counts = df["status"].value_counts()

print("\nStatus Distribution:")
print(status_counts)

# Graph
plt.figure(figsize=(8, 5))

bars = plt.bar(
    status_counts.index,
    status_counts.values
)

plt.title("Status Distribution")
plt.xlabel("Status")
plt.ylabel("Number of Customers")

# Values on bars
for bar in bars:
    height = bar.get_height()
    plt.text(
        bar.get_x() + bar.get_width() / 2,
        height,
        str(int(height)),
        ha="center",
        va="bottom"
    )

plt.xticks(rotation=30)
plt.tight_layout()
plt.show()


# Step 7: Income Distribution

plt.figure(figsize=(8, 5))

plt.hist(
    df["income"],
    bins=20,
    edgecolor="black"
)

plt.title("Income Distribution")
plt.xlabel("Income")
plt.ylabel("Number of Customers")

plt.tight_layout()
plt.show()

# Step 8: Tenure Distribution

plt.figure(figsize=(8, 5))

plt.hist(
    df["tenure"],
    bins=20,
    edgecolor="black"
)

plt.title("Tenure Distribution")
plt.xlabel("Tenure (Months)")
plt.ylabel("Number of Customers")

plt.tight_layout()
plt.show()


# Total Spending Distribution

plt.figure(figsize=(10, 6))

plt.hist(df['total'], bins=20, edgecolor='black')

plt.title('Total Spending Distribution')
plt.xlabel('Total Spending')
plt.ylabel('Number of Customers')

plt.tight_layout()
plt.show()

# Income vs Total Spending

plt.figure(figsize=(10, 6))

plt.scatter(df["income"], df["total"], alpha=0.5)

plt.title("Income vs Total Spending")
plt.xlabel("Income")
plt.ylabel("Total Spending")

plt.tight_layout()
plt.show()

# Purchase vs Total Spending

plt.figure(figsize=(8, 6))

plt.boxplot(
    [
        df[df["purchased"] == 0]["total"],
        df[df["purchased"] == 1]["total"]
    ],
    tick_labels=["Not Purchased", "Purchased"]
)

plt.title("Purchase vs Total Spending")
plt.xlabel("Purchase Status")
plt.ylabel("Total Spending")

plt.tight_layout()
plt.show()


plt.figure(figsize=(8, 5))

plt.hist(df["quantity"], bins=30, edgecolor="black")

plt.title("Quantity Distribution")
plt.xlabel("Quantity")
plt.ylabel("Number of Customers")

plt.show()

# Graph 14: Correlation Heatmap

import numpy as np

numeric_df = df.select_dtypes(include="number")
corr = numeric_df.corr()

plt.figure(figsize=(10, 7))

plt.imshow(corr, cmap="coolwarm", interpolation="none")
plt.colorbar(label="Correlation")

plt.xticks(
    range(len(corr.columns)),
    corr.columns,
    rotation=45,
    ha="right"
)

plt.yticks(
    range(len(corr.columns)),
    corr.columns
)

plt.title("Correlation Heatmap")

# Values graph ke andar show karna
for i in range(len(corr.columns)):
    for j in range(len(corr.columns)):
        plt.text(
            j,
            i,
            round(corr.iloc[i, j], 2),
            ha="center",
            va="center"
        )

plt.tight_layout()
plt.show()